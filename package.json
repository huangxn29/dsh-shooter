{
  "name": "dsh-shooter",
  "version": "1.2.0",
  "description": "A top-down arena shooter panel for DeepSeek Harness, with a watch mode where the desktop pet plays by itself while you watch, plus local leaderboard, achievements and skins.",
  "license": "MIT",
  "type": "module",
  "icon": "icon.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "game",
    "shooter",
    "canvas",
    "sidebar",
    "watch-mode",
    "autopilot",
    "desktop-pet",
    "arcade"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangxn29/dsh-shooter.git"
  },
  "homepage": "https://github.com/huangxn29/dsh-shooter#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "sim": "node scripts/sim-ai.mjs",
    "sim:ui": "node scripts/sim-ui.mjs",
    "sim:pet": "node scripts/sim-pet.mjs",
    "sim:features": "node scripts/sim-features.mjs",
    "sim:meta": "node scripts/sim-meta.mjs",
    "check": "node --check client.js && node scripts/sim-ai.mjs 20000 && node scripts/sim-ui.mjs && node scripts/sim-pet.mjs && node scripts/sim-features.mjs && node scripts/sim-meta.mjs",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
