{
  "name": "dsh-shooter",
  "version": "1.0.1",
  "description": "A top-down arena shooter that opens as a full panel from a left sidebar entry in DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "icon": "icon.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "game",
    "shooter",
    "canvas",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangxn29/dsh-shooter.git"
  },
  "homepage": "https://github.com/huangxn29/dsh-shooter#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
